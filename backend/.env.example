# ==============================================================================
# Environment Configuration Template for ManganeseInsight Backend
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file or production secret keys to version control.

# Application Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173

# Google Earth Engine (GEE) Configuration
# Google Cloud Project ID with Earth Engine API enabled
GEE_PROJECT_ID=
# Service account email associated with your Google Cloud Project
GEE_SERVICE_ACCOUNT=
# Service account private key (if passing key string directly)
GEE_PRIVATE_KEY=
# Path to your Google Cloud Service Account JSON credentials key file (alternative to private key string)
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Future Database (MySQL) Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=manganese_insight
DB_USER=root
DB_PASSWORD=
